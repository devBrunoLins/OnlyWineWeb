# Formulário de contato (/contato → app/api/contato/route.ts)
#
# Sem estas variáveis a rota responde 503 e a interface orienta a pessoa a
# escrever direto para contact@onlywine.app — o canal de contato nunca fica
# indisponível, mas o formulário não envia.
#
# Configure na Vercel em: Settings → Environment Variables.

# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remetente verificado. O domínio onlywine.app precisa estar verificado no
# Resend (Settings → Domains), senão o envio é rejeitado.
CONTACT_FROM="OnlyWine <site@onlywine.app>"
